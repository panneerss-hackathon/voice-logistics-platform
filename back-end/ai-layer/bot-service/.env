# Azure Bot Framework Credentials
MICROSOFT_APP_ID=your-app-id-here
MICROSOFT_APP_PASSWORD=your-app-password-here
MICROSOFT_APP_TYPE=MultiTenant

# Cosmos DB Settings (used only if USE_MOCK_DB=false)
COSMOS_DB_ENDPOINT=http://fake
COSMOS_DB_KEY=fake
COSMOS_DB_DATABASE=BotDatabase
COSMOS_DB_CONTAINER=BotState

# Flags for local testing
USE_MOCK_DB=true
USE_MOCK_SERVICE=true
